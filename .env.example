# Modèle utilisé par deployer.sh : ne pas copier à la main.
# Lancez ./deployer.sh, qui crée .env avec les droits 600.

# Propriétaire (UID/GID) des fichiers de ./data et ./backups.
# Un changement nécessite une reconstruction : docker compose build
PUID=1000
PGID=1000

# Port publié sur l'hôte. Le serveur écoute toujours sur 9000 dans le conteneur.
BCDI_HOST_PORT=9000

# Nom d'hôte vu par le serveur (les clients Windows utilisent l'IP ou le DNS).
BCDI_HOSTNAME=bcdi

TZ=Europe/Paris

# Durée de conservation des sauvegardes (jours).
BACKUP_KEEP_DAYS=30

# Emplacement d'installation DANS le conteneur.
# Défaut Canopé : /usr/bcdiserv. À ne modifier que pour reprendre une
# installation existante (par exemple /home/bcdiserv, chemin de l'ancien serveur).
#BCDI_HOME=/usr/bcdiserv

# Licence BCDI (espace client). Si les deux valeurs sont renseignées,
# l'installation se fait sans interaction ; sinon l'installeur les demande.
#BCDI_ETABLISSEMENT=NOM_DE_L_ETABLISSEMENT
#BCDI_GRIFFE=CODE_INSTALLATION
#BCDI_MAIL_ADMIN=documentaliste@etablissement.fr
